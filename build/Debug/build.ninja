build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/trung/Documents/My_project/STMproject/build/Debug/cmake/stm32cubemx && /usr/bin/cmake --regenerate-during-build -S/home/trung/Documents/My_project/STMproject -B/home/trung/Documents/My_project/STMproject/build/Debug
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build STM32_Drivers: phony cmake/stm32cubemx/STM32_Drivers

build STMproject: phony STMproject.elf

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /home/trung/Documents/My_project/STMproject/build/Debug

build all: phony STMproject.elf cmake/stm32cubemx/all

# =============================================================================

#############################################
# Folder: /home/trung/Documents/My_project/STMproject/build/Debug/cmake/stm32cubemx

build cmake/stm32cubemx/all: phony cmake/stm32cubemx/STM32_Drivers

