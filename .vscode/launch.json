{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "STM32F411 - ST-Link",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/STMproject.elf",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "device": "STM32F411CE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "STM32: build Debug",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
